# ========================================
# 🧪 PRUEBAS API BRAINSURE CUIDADORES
# ========================================
# Usa este archivo con Thunder Client, Postman, o REST Client de VS Code
# Para usar con REST Client, instala la extensión "REST Client" en VS Code

@baseUrl = http://localhost:3000
@contentType = application/json

### ========================================
### 1. VERIFICAR QUE EL SERVIDOR ESTÁ CORRIENDO
### ========================================

GET {{baseUrl}}

### ========================================
### 2. REGISTRO DE USUARIO
### ========================================

POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Juan Pérez Cuidador",
  "email": "juan.perez@test.com",
  "password": "password123",
  "confirmPassword": "password123"
}

### ========================================
### 3. REENVIAR CÓDIGO DE VERIFICACIÓN
### ========================================

POST {{baseUrl}}/api/auth/resend-code
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com"
}

### ========================================
### 4. VERIFICAR CUENTA CON CÓDIGO
### ========================================
### IMPORTANTE: Copia el código de 6 dígitos que aparece en la consola del servidor
### después de registrarte o reenviar el código

POST {{baseUrl}}/api/auth/verify
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "code": "123456"
}

### ========================================
### 5. LOGIN (Después de verificar)
### ========================================

POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "password": "password123"
}

### ========================================
### 6. LOGIN SIN VERIFICAR (Debe fallar)
### ========================================

POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "María García",
  "email": "maria.garcia@test.com",
  "password": "password123",
  "confirmPassword": "password123"
}

###

POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "maria.garcia@test.com",
  "password": "password123"
}

### ========================================
### 7. OBTENER PERFIL (Requiere token)
### ========================================
### IMPORTANTE: Reemplaza YOUR_TOKEN_HERE con el token que recibiste al hacer login

GET {{baseUrl}}/api/auth/profile
Authorization: Bearer YOUR_TOKEN_HERE

### ========================================
### 8. RECUPERAR CONTRASEÑA
### ========================================

POST {{baseUrl}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com"
}

### ========================================
### 9. RESETEAR CONTRASEÑA CON CÓDIGO
### ========================================
### IMPORTANTE: Copia el código que aparece en la consola del servidor

POST {{baseUrl}}/api/auth/reset-password
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "code": "123456",
  "newPassword": "newpassword456",
  "confirmPassword": "newpassword456"
}

### ========================================
### 10. LOGIN CON NUEVA CONTRASEÑA
### ========================================

POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "password": "newpassword456"
}

### ========================================
### PRUEBAS DE VALIDACIÓN (Deben fallar)
### ========================================

### Email inválido
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "email": "email-invalido",
  "password": "password123",
  "confirmPassword": "password123"
}

###

### Contraseña muy corta
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "email": "test@test.com",
  "password": "123",
  "confirmPassword": "123"
}

###

### Contraseñas no coinciden
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "email": "test@test.com",
  "password": "password123",
  "confirmPassword": "password456"
}

###

### Nombre muy corto
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "AB",
  "email": "test@test.com",
  "password": "password123",
  "confirmPassword": "password123"
}

###

### Email duplicado
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Otro Usuario",
  "email": "juan.perez@test.com",
  "password": "password123",
  "confirmPassword": "password123"
}

###

### Login con credenciales incorrectas
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "password": "contraseña_incorrecta"
}

###

### Acceder a perfil sin token
GET {{baseUrl}}/api/auth/profile

###

### Acceder a perfil con token inválido
GET {{baseUrl}}/api/auth/profile
Authorization: Bearer token_invalido_12345

###

### Verificar con código incorrecto
POST {{baseUrl}}/api/auth/verify
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "code": "000000"
}

###

### Código de verificación expirado (después de 10 minutos)
POST {{baseUrl}}/api/auth/verify
Content-Type: {{contentType}}

{
  "email": "juan.perez@test.com",
  "code": "123456"
}